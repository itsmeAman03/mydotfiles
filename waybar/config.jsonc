//   | |/ |/ // __ | \  // _  |/ __ | / , _/ / /__ / /_/ //    // _/ _/ / / (_ /
//   |__/|__//_/ |_| /_//____//_/ |_|/_/|_|  \___/ \____//_/|_//_/  /___/ \___/
//=============================================================================

{
  "layer": "top", // Waybar at top layer
  "position": "top", // Waybar position (top|bottom|left|right)
  //"width": 1920, // Waybar width
  // Choose the order of the modules
  "reload_style_on_change": true,

  //MODULE LEFT
  "modules-left": ["hyprland/workspaces", "hyprland/window"],

  //MODULE CENTER
  "modules-center": ["mpris"],

  //MODULE RIGHT
  "modules-right": [
    "cpu",
    "memory",
    "disk",
    "pulseaudio",
    //"bluetooth",
    "backlight",
    "battery",
    "clock",
    "network",
    "tray",
    "custom/notification",
    "custom/lock",
    "custom/power",
  ],
  //Empty
  "custom/empty": {
    "format": "{icon}",
    "format-icons": "",
  },
  "tray": {
    "icon-size": 15,
    "spacing": 10,
  },
  //===========================================================================
  "hyprland/workspaces": {
    "all-output": true,
    "active-only": false,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "1": "󰣇",
      "2": "",
      "3": "󰈹",
      "4": "",
      "5": "",
      "6": "",
      "8": "",
      "9": "",
      "active": "",
      "default": "",
    },
    "persistent-workspaces": {
      "*": 5,
    },
  },
  //============================================================================
  "hyprland/window": {
    "format": " {}",
    "max-length": 40,
    "tooltip": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": " $1",
      "(.*) — Google Chrome": "  $1",
      "(.*) YouTube — Mozilla Firefox": "  $1",
      "(.*) GitHub — Mozilla Firefox": "  $1",
      "(.*) WhatsApp — Mozilla Firefox": " $1",
      "(.*) Reddit - The heart of the internet — Mozilla Firefox": " $1",
      "(.*) Gmail — Mozilla Firefox": "󰊫 $1",
    },
    "separate-outputs": true,
  },
  //============================================================================
  //Memory
  "memory": {
    "interval": 30,
    "format": " {percentage}%",
    "format-alt": " {used:0.1f}G/{total:0.1f}G",
    "tooltip": false,
  },
  //CPU
  "cpu": {
    "interval": 10,
    "format": "{icon} {usage}%",
    "format-icons": [
      "<span color='#69ff94'>▁</span>", // green
      "<span color='#2aa9ff'>▂</span>", // blue
      "<span color='#f8f8f2'>▃</span>", // white
      "<span color='#f8f8f2'>▄</span>", // white
      "<span color='#ffffa5'>▅</span>", // yellow
      "<span color='#ffffa5'>▆</span>", // yellow
      "<span color='#ff9977'>▇</span>", // orange
      "<span color='#dd532e'>█</span>" // red
    ]
  },
  // Harddisc space used
  "disk": {
    "interval": 30,
    "format": " {percentage_used}%",
    "path": "/",
    "format-icons": [""],
    "tooltip": false,
    "tooltip-format": "{specific_free:0.2f}GB / {specific_total:0.2f}GB",
  },

  //============================================================================================
  // Pulseaudio
  "pulseaudio": {
    "scroll-step": 5, // %, can be a float
    "format": "{format_source} {icon} {volume}%",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": "{icon} {format_source}",
    "format-muted": " {format_source}  ",
    "format-source": " {volume}%",
    "format-source-muted": "󰍭",
    "format-icons": {
      "headphone": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click-right": "pavucontrol",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "max-length": 25,
  },
  //==============================================================================================
  "backlight": {
    "scroll-step": 1,
    "device": "intel_backlight",
    "format": "{icon}",
    "tooltip": false,
    "on-scroll-up": "brightnessctl -e2 -n2 set 5%+",
    "on-scroll-down": " brightnessctl -e2 -n2 set 5%-",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "󰃞",
      "󰃝",
      "󰃟",
      "󰃠",
    ],
  },
  //-----------------------------------------------------------------------------------------------------------
  "battery": {
    "bat": "BAT0",
    "interval": 10,

    "states": {
      "warning": 20,
      "critical": 10,
    },
    "format": "{icon} {capacity}%",
    "format-alt": "{icon}",

    "format-full": "󰁹",
    "full-at": 96,
    "format-icons": {
      "discharging": ["󰂃", "󰂎", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "plugged": ["󰢜", "󰂆", "󰂆", "󰂆", "󰂆", "󰂆", "󰂆", "󰂆", "󰂋", "󰂅"],
      "charging": ["󰢜", "󰂆", "󰂆", "󰂆", "󰂆", "󰂆", "󰂆", "󰂆", "󰂋", "󰂅"],
    },
    "tooltip": false,
    "max-length": 25,
  },
  //---------------------------------------------------------------------------------------------------------------
  "mpris": {
    "format": "{player_icon} {status_icon} {title} - {artist} | {album}",
    "format-paused": "{status_icon} <i>{title} - {artist}</i> | {position}",
    "player-icons": {
      "default": "▶",
      "mpv": "🎵",
      "spotify": "",
      "vlc": "󰕼",
    },
    "tooltip": false,
    "status-icons": {
      "paused": "⏸",
      "playing": "",
      "stopped": "",
      "next": "󰙡",
      "previous": "󰙣",
    },
    "max-length": 72,
  },
  //===========================================================
  "clock": {
    "timezone": "Asia/Kolkata",
    "format": "󰥔 {:%H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": " {:%d/%m/%Y}",
    "max-length": 25,
  },
  //===========================================================================================
  "network": {
    "format": "{ifname}",
    "format-wifi": " {essid}",
    "format-ethernet": "{ifname}",
    "format-disconnected": "Disconnected ⚠",
    "tooltip-format": "{ifname} via {gwaddri}",
    "tooltip-format-wifi": " {ifname} @ {essid}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "tooltip-format-ethernet": "{ifname}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 25,
    "on-click": "~/.config/waybar/Scripts/nm-applet.sh toggle",
  },
  //===========================================================================
  "custom/lock": {
    "format": "",
    "tooltip": false,
    "on-click": "~/.config/waybar/Scripts/lock.sh",
  },
  "custom/power": {
    "tooltip": false,
    "on-click": "$HOME/.config/rofi/powermenu/type-2/powermenu.sh",
    "format": "⏻",
  },
  //bluetooth
  "bluetooth": {
    "format": " {status}",
    "format-disabled": "",
    "format-off": "",
    "interval": 25,
    "on-click": "blueman-applet",
    "format-no-controller": "",
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": "",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
}
